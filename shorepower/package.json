{
  "name": "shorepower-pipeline",
  "version": "1.0.0",
  "private": true,
  "description": "港口岸电用量日账本地数据管道：GB18030 CSV 接电记录 + UTF-8 JSONL 电表读数",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start:server": "tsx src/cli.ts serve --data ./data --port 8080",
    "run": "tsx src/cli.ts run",
    "rerun": "tsx src/cli.ts rerun",
    "demo": "tsx scripts/demo.ts",
    "gen:fixtures": "tsx scripts/generate-fixtures.ts",
    "test": "node --import tsx --test test/*.test.ts"
  },
  "dependencies": {
    "iconv-lite": "^0.6.3"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
